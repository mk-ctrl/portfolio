---
import SectionHead from './SectionHead.astro';
import { profile } from '../data/content';
---

<section id="contact" class="wrap pt-28 md:pt-40" aria-labelledby="contact-title">
  <SectionHead n="06" label="Contact" />

  <div class="relative mt-10 md:mt-16" data-bubble-zone>
    <a href={`mailto:${profile.email}`} class="group block cursor-none max-md:cursor-pointer" aria-describedby="contact-mail">
      <h2 id="contact-title" class="lines display text-[clamp(3.2rem,11vw,11.5rem)]">
        <span class="line"><span style="--i:0">Let’s build</span></span>
        <span class="line"><span style="--i:1">something</span></span>
        <span class="line"><span style="--i:2" class="display-italic text-accent">useful.</span></span>
      </h2>
    </a>

    <span
      data-bubble
      class="pointer-events-none absolute left-0 top-0 grid size-32 scale-0 place-items-center rounded-full bg-ink text-center text-paper transition-transform duration-500 ease-[var(--ease-out-expo)] [&.is-on]:scale-100"
      aria-hidden="true"
    >
      <span class="label !text-paper">Write<br />to me</span>
    </span>
  </div>

  <div class="mt-14 grid gap-10 border-t border-rule pt-10 md:mt-20 md:grid-cols-12 md:gap-6">
    <div class="md:col-span-6" data-reveal>
      <p class="label">Email</p>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <a id="contact-mail" href={`mailto:${profile.email}`} class="serif link-rule break-all text-[clamp(1.25rem,2.4vw,2rem)]">
          {profile.email}
        </a>
        <button type="button" class="label label-ink link-draw" data-copy={profile.email}>Copy</button>
      </div>
    </div>
    <div class="md:col-span-3 md:col-start-8" data-reveal style="--d:1">
      <p class="label">Elsewhere</p>
      <ul class="mt-3 space-y-1">
        <li><a class="serif link-rule text-[1.3rem]" href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
        <li><a class="serif link-rule text-[1.3rem]" href={profile.links.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
      </ul>
    </div>
    <div class="md:col-span-2 md:col-start-11" data-reveal style="--d:2">
      <p class="label">Based in</p>
      <p class="serif mt-3 text-[1.3rem] leading-snug">Tiruchirappalli, India</p>
      <p class="label mt-2 tabular-nums"><span data-clock>--:--</span> IST</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        const prev = b.textContent;
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = prev), 1600);
      } catch {}
    });
  });
</script>
